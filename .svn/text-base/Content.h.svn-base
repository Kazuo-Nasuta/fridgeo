#import <CoreData/CoreData.h>

@class Item;
@class Storage;

@interface Content :  NSManagedObject  
{
}

@property (nonatomic, retain) NSString * expireStr;
@property (nonatomic, retain) NSString * primitiveExpireStr;
@property (nonatomic, retain) NSDate * expireDate;
@property (nonatomic, retain) NSDate * primitiveExpireDate;
@property (nonatomic, retain) NSString * entryStr;
@property (nonatomic, retain) NSString * primitiveEntryStr;
@property (nonatomic, retain) NSDate * entryDate;
@property (nonatomic, retain) NSDate * primitiveEntryDate;
@property (nonatomic, retain) NSString * qty;
@property (nonatomic, retain) Item * item;
@property (nonatomic, retain) Storage * storage;

@end



